      "statusCode": 301
    },
    {
      "source": "/ar/blog/search-youtube-transcript/",
      "destination": "/ar/blog/search-youtube-video/",
      "statusCode": 301
    },
    {
      "source": "/ar/blog/why-youtube-search-fails/",
      "destination": "/ar/blog/search-youtube-video/",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "/about/",
      "statusCode": 301
