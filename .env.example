# JumpTo frontend environment variables
# Copy to .env to override defaults

# API base URL. Leave EMPTY in production: qfza.app/api/* is rewritten to the
# backend by vercel.json, so the browser only ever talks to one origin and the
# HttpOnly session cookie is sent normally. A cross-origin base would make the
# browser treat every auth call as third party and drop the cookie.
# In development, Vite proxies /api to the backend (vite proxy config), so you
# normally leave this empty there too.
VITE_API_BASE_URL=http://localhost:8000

# ── Accounts, Google sign-in ────────────────────────────────────────────────
# Per-deployment CSRF secret. It is NOT a credential: the same value is served
# by GET /api/v1/auth/session and it has no effect without the HttpOnly session
# cookie, which a cross-site page cannot read. It is baked in only so a
# signed-in visitor's first mutation is not rejected while that fetch is still
# in flight. Must match CSRF_TOKEN in the backend's environment.
# VITE_CSRF_TOKEN=

# Header the backend reads the CSRF token from. Only change alongside the
# backend's CSRF_HEADER_NAME.
# VITE_CSRF_HEADER_NAME=X-CSRF-Token

# Google sign-in client id for the "Continue with Google" button. Must match
# GOOGLE_CLIENT_ID in the backend's environment — the backend refuses a token
# minted for any other client. Leave empty and the button is not rendered at
# all, rather than rendered and broken.
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Canonical site origin (no trailing slash) stamped into canonical/OG tags,
# sitemap.xml and robots.txt during `vite build`. Override in the host's
# environment (e.g. Vercel) whenever the published domain differs.
# Default: https://qfza.app
VITE_SITE_URL=https://qfza.app

# Max time (ms) to poll job status before showing a timeout error.
# Default is 300000 (5 minutes).
# VITE_POLL_TIMEOUT_MS=600000

# Contact email shown on the /contact page mailto link.
# Set this in the host's environment for production builds (e.g. Vercel).
# Code falls back to a default when unset.
VITE_CONTACT_EMAIL=support@qfza.app

# Contact form endpoint the form POSTs JSON to ({name, email, message}).
# When empty, the app derives <VITE_API_BASE_URL>/api/contact, i.e. the contact
# form rides the JumpTo backend (which must have POST /api/contact and CORS
# allowing the frontend origin). Set this only to override with a third-party
# form service (e.g. https://formspree.io/f/xxxxxxx).
VITE_CONTACT_FORM_ENDPOINT=
# Set to true to replace the landing page with a maintenance notice.
# The page is noindex so a forgotten flag cannot deindex the site.
# VITE_MAINTENANCE=true

# True returns a real 503 with the maintenance page (Vercel Edge Middleware in
# middleware.ts). A 200 fallback is baked into the build by
# scripts/apply-maintenance.mjs, so removing middleware.ts still works.
