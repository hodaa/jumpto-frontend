# JumpTo frontend environment variables
# Copy to .env to override defaults

# API base URL.
# Default is same-origin (''), which works in production only when the API is
# served from the same origin (e.g. behind a reverse proxy).
# In development, Vite proxies /api to the backend (viteproxy config), so you
# normally do NOT need to set this.
# For production deployments where the API lives on another origin, set the
# published API base URL, e.g.:
# API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8000

# Max time (ms) to poll job status before showing a timeout error.
# Default is 300000 (5 minutes).
# VITE_POLL_TIMEOUT_MS=300000